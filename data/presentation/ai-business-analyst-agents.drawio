        <!-- Requirements Analyst -->
        <mxCell id="a1" value="&lt;b&gt;📋 Requirements Analyst&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• Interpreta lenguaje de negocio&lt;br&gt;• Extrae KPIs · dimensiones · filtros&lt;br&gt;• Detecta ambigüedades&lt;br&gt;• Genera spec técnica del análisis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a4f;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="545" y="80" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- Data Catalog Specialist -->
        <mxCell id="a2" value="&lt;b&gt;📚 Data Catalog Specialist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• Localiza tablas y columnas en BQ&lt;br&gt;• Mapea conceptos negocio → campos&lt;br&gt;• Identifica relaciones entre tablas&lt;br&gt;• Valida disponibilidad del dato&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a4f;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- SQL Translator -->
        <mxCell id="a3" value="&lt;b&gt;⚙️ SQL Translator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• Genera queries BigQuery optimizados&lt;br&gt;• Aplica filtros de partición&lt;br&gt;• Maneja joins · CTEs · window fn&lt;br&gt;• Valida costo antes de ejecutar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a4f;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1055" y="80" width="210" height="90" as="geometry" />
        </mxCell>

