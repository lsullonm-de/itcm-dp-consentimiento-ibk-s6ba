        <mxCell id="p2top" value="📚 APRENDIZAJE" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#01579B;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="267" y="76" width="238" height="24" as="geometry"/>
