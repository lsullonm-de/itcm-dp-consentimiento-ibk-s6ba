        <mxCell id="p2body" value="&lt;p style=&apos;margin:0 0 8px 0;&apos;&gt;&lt;b&gt;☑ Framework Google ADK&lt;/b&gt;&lt;/p&gt;LlmAgent, SequentialAgent, ParallelAgent, callbacks, herramientas y pipeline de seguridad.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Stack y estándares INCA&lt;/b&gt;&lt;/p&gt;Cloud Run, BigQuery, Workflows, naming y estructura de repositorios según estándares del equipo.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Pruebas y error de tiempos&lt;/b&gt;&lt;/p&gt;Identificación de cuellos de botella: contextos extensos, queries sin optimizar, cold start en Cloud Run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#90CAF9;fontColor=#01579B;fontSize=11;arcSize=4;align=left;spacingLeft=12;spacingRight=10;spacingTop=12;verticalAlign=top;" vertex="1" parent="1">
