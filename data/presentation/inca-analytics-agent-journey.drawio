        <mxCell id="p5body" value="&lt;p style=&apos;margin:0 0 8px 0;&apos;&gt;&lt;b&gt;☑ Pruebas de respuestas&lt;/b&gt;&lt;/p&gt;Validación manual de queries generados y corrección de errores del agente.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Mejora de tiempos&lt;/b&gt;&lt;/p&gt;Redis cache por SQL (SHA-256) · reducción de contexto · Dry Run antes de ejecutar en BigQuery.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Ajuste de contextos (.md)&lt;/b&gt;&lt;/p&gt;Catálogos con reglas de negocio precisas:&lt;br/&gt;• HLL para transacciones&lt;br/&gt;• Filtro de departamento obligatorio&lt;br/&gt;• Fechas dinámicas: MAX(process_date)&lt;br/&gt;• Queries de referencia por período" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#FFAB91;fontColor=#BF360C;fontSize=11;arcSize=4;align=left;spacingLeft=12;spacingRight=10;spacingTop=12;verticalAlign=top;" vertex="1" parent="1">
