        <mxCell id="p3body" value="&lt;p style=&apos;margin:0 0 8px 0;&apos;&gt;&lt;b&gt;☑ Mejoramiento de contextos&lt;/b&gt;&lt;/p&gt;Reducción y enfoque de archivos de contexto. Primeras reglas de negocio documentadas.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Arquitectura de servicios&lt;/b&gt;&lt;/p&gt;Front (React) · Agente ADK (Cloud Run) · BFF FastAPI · Cache Redis · BigQuery.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Mockups del front&lt;/b&gt;&lt;/p&gt;ChatPanel, Dashboard, widgets de gráficos y flujo de navegación.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Stack de visualizaciones&lt;/b&gt;&lt;/p&gt;ECharts para gráficos · AG Grid para tablas de resultados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#80CBC4;fontColor=#004D40;fontSize=11;arcSize=4;align=left;spacingLeft=12;spacingRight=10;spacingTop=12;verticalAlign=top;" vertex="1" parent="1">
