        <mxCell id="p6dot" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#880E4F;strokeColor=#880E4F;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
