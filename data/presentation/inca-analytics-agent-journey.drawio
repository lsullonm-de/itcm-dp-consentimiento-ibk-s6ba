        </mxCell>
        <mxCell id="p1body" value="&lt;p style=&apos;margin:0 0 8px 0;&apos;&gt;&lt;b&gt;☑ Lluvia de ideas&lt;/b&gt;&lt;/p&gt;Definición del alcance y las preguntas de negocio que debía responder el agente.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Prototipo inicial&lt;/b&gt;&lt;/p&gt;Primera versión funcional del agente conversacional.&lt;br/&gt;&lt;br/&gt;&lt;span style=&apos;color:#7E57C2;font-weight:bold;&apos;&gt;⏱ ~2 min por respuesta&lt;/span&gt;&lt;br/&gt;Tablas grandes, contextos sin optimizar, sin cache." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#B39DDB;fontColor=#311B92;fontSize=11;arcSize=4;align=left;spacingLeft=12;spacingRight=10;spacingTop=12;verticalAlign=top;" vertex="1" parent="1">
