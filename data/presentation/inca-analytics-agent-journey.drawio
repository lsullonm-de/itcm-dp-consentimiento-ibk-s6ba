        </mxCell>
        <mxCell id="p6body" value="&lt;p style=&apos;margin:0 0 8px 0;&apos;&gt;&lt;b&gt;☑ 33 preguntas de negocio&lt;/b&gt;&lt;/p&gt;Ground truth verificado en BigQuery: tabla correcta + query + respuesta esperada.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Juez IA con Claude&lt;/b&gt;&lt;/p&gt;Evaluación automática en 3 dimensiones:&lt;br/&gt;• Tabla usada (5%)&lt;br/&gt;• SQL generado (5%)&lt;br/&gt;• Respuesta final (90%)&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Puntuación de performance&lt;/b&gt;&lt;/p&gt;Score general · por categoría · por pregunta. Detección de regresiones.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b style=&apos;color:#880E4F;&apos;&gt;✅ Reporte de resultados&lt;/b&gt;&lt;/p&gt;Publicado como artefacto interactivo en Claude con hallazgos y próximos pasos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#F48FB1;fontColor=#880E4F;fontSize=11;arcSize=4;align=left;spacingLeft=12;spacingRight=10;spacingTop=12;verticalAlign=top;" vertex="1" parent="1">
