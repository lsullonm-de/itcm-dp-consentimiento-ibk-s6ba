        <mxCell id="p2dot" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#01579B;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
