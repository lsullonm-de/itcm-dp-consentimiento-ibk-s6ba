          <mxGeometry x="761" y="158" width="238" height="6" as="geometry"/>
        </mxCell>
        <mxCell id="p4body" value="&lt;p style=&apos;margin:0 0 8px 0;&apos;&gt;&lt;b&gt;☑ Árbol de agentes&lt;/b&gt;&lt;/p&gt;Intent → Semántico → SQL → (Insights ‖ Chips). Pipeline multi-agente con Google ADK.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Construcción del agente&lt;/b&gt;&lt;/p&gt;Tools: search_schema · execute_analytics_query · select_visualization + SqlReadOnlyGuard.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ Widgets de gráficos en el front&lt;/b&gt;&lt;/p&gt;Gráficos guardados como componentes reutilizables integrados al Dashboard.&lt;p style=&apos;margin:10px 0 8px 0;&apos;&gt;&lt;b&gt;☑ BFF y persistencia&lt;/b&gt;&lt;/p&gt;FastAPI + PostgreSQL: sesiones, análisis, versiones, compartidos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#A5D6A7;fontColor=#1B5E20;fontSize=11;arcSize=4;align=left;spacingLeft=12;spacingRight=10;spacingTop=12;verticalAlign=top;" vertex="1" parent="1">
